# ============================================================================
# AegisOps Emergency Response Platform - Environment Variables
# ============================================================================

# Server Configuration
PORT=4000
NODE_ENV=production

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# PostgreSQL & PostGIS (Optional - Fallbacks to Resilient In-Memory DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegisops_db

# Twilio SMS Alert Notifications (Trial / Live Master Credentials)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# OpenWeatherMap API (Optional / Live Ground Telemetry)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# LLM APIs for Multilingual Triage & Threat Classification
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
