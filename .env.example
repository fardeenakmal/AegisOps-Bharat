# ==============================================================================
# AegisOps Bharat - Production Environment Variables Configuration Template
# Copy this file to .env before starting production deployments
# ==============================================================================

# --- Ingress & Web Server ---
PORT=80
BACKEND_PORT=4000
VITE_API_URL=

# --- Spring Boot Application Configuration ---
SPRING_PROFILES_ACTIVE=mysql
SERVER_PORT=4000
JWT_SECRET=replace-with-a-random-32-plus-character-secret-in-production!
SPRING_FLYWAY_ENABLED=true

# --- MySQL Database Configuration ---
MYSQL_PORT=3306
MYSQL_DATABASE=emergency_db
MYSQL_USER=emergency_user
MYSQL_PASSWORD=change_this_emergency_pass_in_prod_2026
MYSQL_ROOT_PASSWORD=change_this_root_pass_in_prod_2026

# --- Redis Broker Configuration ---
REDIS_PORT=6379

# --- Geographic & Sector Defaults ---
DEFAULT_REGION_CODE=INDIA
DEFAULT_CENTER_LAT=22.0
DEFAULT_CENTER_LON=78.9629
DEFAULT_ZOOM=5
